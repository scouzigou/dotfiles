# vim:fileencoding=utf-8:foldmethod=marker
#
hide_window_decorations true

# BEGIN_KITTY_FONTS
font_family      family=Hack postscript_name=Hack-Regular
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS

# BEGIN_KITTY_THEME
# GitHub Dark Dimmed
include current-theme.conf
# END_KITTY_THEME
